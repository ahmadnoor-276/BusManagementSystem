# --- Local development (SQLite, default) ---
# No external database required. Uses a local file.
DATABASE_URL="file:./dev.db"

# --- Production (PostgreSQL on Neon/Supabase, free tier) ---
# 1. In prisma/schema.prisma set:  provider = "postgresql"
# 2. Set DATABASE_URL to your Neon/Supabase connection string, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Authentication ---
# Secret used to sign session cookies. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Admin credentials used by `npm run db:seed` to create/update the admin user.
# Change these before seeding. The password is stored only as a bcrypt hash.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChooseYourPassword"
